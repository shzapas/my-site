<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>STOCKWISE — Рабочий портал</title>
<style>
  :root{
    --orange:#ffa938;
    --orange-dark:#e89320;
    --orange-light:#ffcf7a;
    --blue-light:#ddeeff;
    --blue-dark:#2c3e50;
    --white:#ffffff;
    --gray:#6b7a8d;
    --shadow:0 4px 16px rgba(44,62,80,0.10);
    --shadow-hover:0 12px 32px rgba(255,169,56,0.35);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Segoe UI', system-ui, -apple-system, Roboto, sans-serif;
    background:linear-gradient(180deg,#ddeeff 0%, #f4f9ff 100%);
    color:var(--blue-dark);
    min-height:100vh;
    line-height:1.5;
    overflow-x:hidden;
  }

  /* ЖИВОЙ ФОН */
  .bg-blobs{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none;}
  .blob{position:absolute;border-radius:50%;filter:blur(80px);opacity:.3;animation:blobFloat 18s ease-in-out infinite;}
  .blob.b1{width:400px;height:400px;background:var(--orange);top:-120px;left:-120px;}
  .blob.b2{width:340px;height:340px;background:#7fb4ff;bottom:-100px;right:-80px;animation-delay:-6s;}
  .blob.b3{width:280px;height:280px;background:var(--orange-light);top:40%;left:60%;animation-delay:-12s;}
  @keyframes blobFloat{
    0%,100%{transform:translate(0,0) scale(1);}
    33%{transform:translate(40px,-30px) scale(1.1);}
    66%{transform:translate(-30px,30px) scale(.95);}
  }

  /* ПРОГРЕСС-БАР */
  .read-progress{
    position:fixed;top:0;left:0;height:3px;width:0%;
    background:linear-gradient(90deg,var(--orange),var(--orange-light));
    z-index:999;transition:width .1s linear;
    box-shadow:0 0 10px rgba(255,169,56,.6);
  }

  /* ШАПКА */
  header{
    background:linear-gradient(135deg, var(--blue-dark) 0%, #1a2735 100%);
    color:#fff;padding:18px 20px;
    box-shadow:0 4px 20px rgba(0,0,0,0.15);
    position:relative;overflow:hidden;
  }
  header::after{
    content:"";position:absolute;right:-60px;top:-60px;
    width:180px;height:180px;background:var(--orange);
    opacity:.15;border-radius:50%;
    animation:blobFloat 14s ease-in-out infinite;
  }
  .header-inner{
    max-width:1200px;margin:0 auto;
    display:flex;align-items:center;gap:20px;
    position:relative;z-index:2;
  }
  .logo{display:flex;align-items:center;gap:12px;font-size:24px;font-weight:800;}
  .logo-mark{
    width:46px;height:46px;background:var(--orange);
    border-radius:12px;display:flex;align-items:center;justify-content:center;
    font-size:24px;box-shadow:0 4px 14px rgba(255,169,56,.5);
    animation:float 3s ease-in-out infinite;
  }
  @keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-4px);}}
  .logo-text small{
    display:block;font-size:11px;font-weight:400;
    color:var(--orange);letter-spacing:2px;text-transform:uppercase;
  }
  .header-actions{margin-left:auto;display:flex;gap:8px;align-items:center;}
  .btn-header{
    background:rgba(255,255,255,.1);
    border:1px solid rgba(255,255,255,.25);
    color:#fff;padding:8px 14px;border-radius:9px;
    font-size:12.5px;text-decoration:none;transition:.25s;
    display:flex;align-items:center;gap:6px;
  }
  .btn-header:hover{background:var(--orange);border-color:var(--orange);transform:translateY(-2px);}

  /* HERO — СЖАТЫЙ */
  .hero{
    max-width:1200px;margin:0 auto;
    padding:32px 20px 12px;
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:32px;
    align-items:center;
  }
  .hero-text h1{
    font-size:clamp(24px, 3vw, 34px);
    font-weight:800;line-height:1.2;
    margin-bottom:12px;
    animation:fadeUp .6s ease both;
  }
  .hero-text h1 span{color:var(--orange);}
  .hero-text p{
    font-size:15px;color:var(--gray);
    margin-bottom:18px;max-width:560px;
    animation:fadeUp .6s .1s ease both;
  }
  .hero-cta{
    display:flex;gap:10px;flex-wrap:wrap;
    animation:fadeUp .6s .15s ease both;
  }
  .btn-primary{
    background:var(--orange);color:#fff;
    padding:11px 22px;border-radius:10px;
    text-decoration:none;font-weight:700;font-size:14px;
    display:inline-flex;align-items:center;gap:8px;
    box-shadow:0 6px 16px rgba(255,169,56,.4);
    transition:.25s;
  }
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 9px 20px rgba(255,169,56,.55);}
  .btn-secondary{
    background:transparent;color:var(--blue-dark);
    padding:11px 22px;border-radius:10px;
    text-decoration:none;font-weight:700;font-size:14px;
    display:inline-flex;align-items:center;gap:8px;
    border:2px solid var(--blue-dark);transition:.25s;
  }
  .btn-secondary:hover{background:var(--blue-dark);color:#fff;transform:translateY(-2px);}

  .hero-art{position:relative;animation:fadeUp .7s .1s ease both;}
  .hero-art svg{width:100%;height:auto;max-height:280px;filter:drop-shadow(0 16px 32px rgba(44,62,80,.12));}
  .float-badge{
    position:absolute;
    background:var(--white);
    border-radius:12px;
    padding:8px 12px;
    box-shadow:0 8px 20px rgba(44,62,80,.15);
    font-size:11.5px;font-weight:700;
    display:flex;align-items:center;gap:6px;
    animation:floatBadge 4s ease-in-out infinite;
  }
  .float-badge.badge-1{top:8%;left:-6px;}
  .float-badge.badge-2{bottom:12%;right:-6px;animation-delay:-2s;}
  @keyframes floatBadge{
    0%,100%{transform:translateY(0);}
    50%{transform:translateY(-8px);}
  }
  @keyframes fadeUp{
    from{opacity:0;transform:translateY(12px);}
    to{opacity:1;transform:translateY(0);}
  }

  /* СТАТИСТИКА — КОМПАКТНАЯ */
  .stats{
    max-width:1000px;margin:14px auto 0;
    padding:0 20px;
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(150px,1fr));
    gap:12px;
  }
  .stat{
    background:var(--white);
    border-radius:14px;
    padding:14px 10px;
    text-align:center;
    box-shadow:var(--shadow);
    border:1px solid #eef3f9;
    transition:.3s;
    animation:fadeUp .5s ease both;
  }
  .stat:hover{transform:translateY(-3px);border-color:var(--orange);}
  .stat .num{
    font-size:22px;font-weight:800;
    color:var(--orange);line-height:1;
    margin-bottom:5px;
  }
  .stat .lbl{
    font-size:10.5px;color:var(--gray);
    text-transform:uppercase;letter-spacing:.5px;font-weight:600;
  }
  .stat .ico{font-size:15px;margin-bottom:3px;display:block;opacity:.85;}

  /* СЕКЦИИ — СЖАТЫЕ */
  .section{max-width:1200px;margin:36px auto 0;padding:0 20px;}
  .section-title{
    font-size:20px;font-weight:800;margin-bottom:6px;
    display:flex;align-items:center;gap:9px;color:var(--blue-dark);
  }
  .section-title .dot{
    width:9px;height:9px;background:var(--orange);border-radius:50%;
    box-shadow:0 0 0 4px rgba(255,169,56,.25);
    animation:pulseDot 2s infinite;
  }
  .section-sub{color:var(--gray);font-size:13.5px;margin-bottom:16px;}
  @keyframes pulseDot{
    0%,100%{box-shadow:0 0 0 4px rgba(255,169,56,.25);}
    50%{box-shadow:0 0 0 8px rgba(255,169,56,.05);}
  }

  /* СЕТКА КАРТОЧЕК */
  .grid{
    max-width:1200px;margin:22px auto 0;
    padding:0 20px;
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(300px, 1fr));
    gap:18px;
  }
  .card{
    background:var(--white);
    border-radius:18px;
    padding:22px 20px 20px;
    box-shadow:var(--shadow);
    position:relative;cursor:pointer;
    transition:transform .28s cubic-bezier(.2,.8,.2,1), box-shadow .28s, border-color .28s;
    border:2px solid transparent;
    overflow:hidden;text-decoration:none;color:inherit;display:block;
    animation:cardIn .5s ease both;
    animation-delay:var(--delay,0s);
  }
  @keyframes cardIn{
    from{opacity:0;transform:translateY(16px) scale(.97);}
    to{opacity:1;transform:translateY(0) scale(1);}
  }
  .card::before{
    content:"";position:absolute;top:0;left:0;right:0;height:4px;
    background:linear-gradient(90deg, var(--orange), var(--orange-light));
    transform:scaleX(0);transform-origin:left;transition:transform .35s;
  }
  .card:hover{
    transform:translateY(-5px);
    box-shadow:var(--shadow-hover);
    border-color:var(--orange);
  }
  .card:hover::before{transform:scaleX(1);}
  .card:active{transform:translateY(-1px) scale(.99);}
  .card-icon{
    width:52px;height:52px;border-radius:14px;
    background:var(--blue-light);
    display:flex;align-items:center;justify-content:center;
    margin-bottom:14px;transition:.35s;
  }
  .card:hover .card-icon{background:var(--orange);transform:rotate(-6deg) scale(1.05);}
  .card-icon svg{
    width:26px;height:26px;stroke:var(--orange-dark);
    fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;
    transition:stroke .3s;
  }
  .card:hover .card-icon svg{stroke:#fff;}
  .card-icon svg path, .card-icon svg rect, .card-icon svg circle, .card-icon svg line{
    stroke-dasharray:100;stroke-dashoffset:100;
    animation:draw 1.2s ease forwards;animation-delay:var(--delay,0s);
  }
  @keyframes draw{to{stroke-dashoffset:0;}}
  .card h3{font-size:17px;font-weight:700;margin-bottom:6px;color:var(--blue-dark);}
  .card p{font-size:13px;color:var(--gray);line-height:1.5;}
  .card .badge{
    display:inline-block;margin-top:10px;
    font-size:10px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;
    color:var(--orange-dark);background:var(--blue-light);
    padding:3px 9px;border-radius:20px;transition:.25s;
  }
  .card:hover .badge{background:var(--orange);color:#fff;}

  /* КНОПКА "i" */
  .info-btn{
    position:absolute;top:14px;right:14px;
    width:26px;height:26px;border-radius:50%;
    background:var(--blue-light);border:none;
    color:var(--orange-dark);font-weight:800;font-size:12px;
    cursor:pointer;display:flex;align-items:center;justify-content:center;
    transition:.25s;z-index:5;font-family:Georgia, serif;
  }
  .info-btn:hover{background:var(--orange);color:#fff;transform:scale(1.15) rotate(8deg);}
  .tooltip{
    position:absolute;top:46px;right:14px;
    width:230px;background:var(--blue-dark);color:#fff;
    padding:12px 14px;border-radius:10px;
    font-size:12.5px;line-height:1.45;
    box-shadow:0 8px 24px rgba(0,0,0,.25);
    opacity:0;visibility:hidden;transform:translateY(-6px);
    transition:.25s;z-index:10;
  }
  .tooltip.show{opacity:1;visibility:visible;transform:translateY(0);}
  .tooltip::before{
    content:"";position:absolute;top:-6px;right:14px;
    width:12px;height:12px;background:var(--blue-dark);transform:rotate(45deg);
  }
  .tooltip strong{color:var(--orange);}

  /* КАК ЭТО РАБОТАЕТ */
  .steps{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));
    gap:16px;
  }
  .step{
    background:var(--white);
    border-radius:16px;
    padding:22px 20px;
    box-shadow:var(--shadow);
    border:1px solid #eef3f9;
    position:relative;
    transition:.3s;
  }
  .step:hover{transform:translateY(-5px);box-shadow:var(--shadow-hover);border-color:var(--orange);}
  .step-num{
    position:absolute;top:-14px;left:20px;
    width:34px;height:34px;border-radius:10px;
    background:var(--orange);color:#fff;
    display:flex;align-items:center;justify-content:center;
    font-weight:800;font-size:16px;
    box-shadow:0 6px 14px rgba(255,169,56,.45);
  }
  .step-ico{font-size:26px;margin-bottom:8px;display:block;}
  .step h4{font-size:15px;font-weight:700;margin-bottom:6px;color:var(--blue-dark);}
  .step p{font-size:12.5px;color:var(--gray);}

  /* КАРУСЕЛЬ — КОМПАКТНАЯ */
  .reviews-wrap{
    background:var(--blue-dark);
    border-radius:20px;
    padding:32px 20px;
    overflow:hidden;
    position:relative;
  }
  .reviews-wrap::before{
    content:"";position:absolute;top:-40px;right:-40px;
    width:160px;height:160px;background:var(--orange);
    opacity:.12;border-radius:50%;filter:blur(40px);
  }
  .reviews-title{
    text-align:center;color:#fff;
    font-size:18px;font-weight:800;margin-bottom:4px;
  }
  .reviews-sub{
    text-align:center;color:#a9b8c9;font-size:12.5px;
    margin-bottom:24px;
  }
  .carousel{
    max-width:680px;
    margin:0 auto;
    position:relative;
    min-height:170px;
  }
  .review{
    position:absolute;inset:0;
    background:var(--white);
    border-radius:16px;
    padding:24px 26px;
    box-shadow:0 16px 40px rgba(0,0,0,.22);
    opacity:0;transform:scale(.92) translateY(8px);
    transition:opacity .6s ease, transform .6s ease;
    pointer-events:none;
    display:flex;flex-direction:column;justify-content:center;
  }
  .review.active{opacity:1;transform:scale(1) translateY(0);pointer-events:auto;z-index:2;}
  .review.prev, .review.next{opacity:.22;transform:scale(.9) translateY(0);pointer-events:none;z-index:1;}
  .review-stars{color:var(--orange);font-size:15px;margin-bottom:10px;letter-spacing:1px;}
  .review-text{
    font-size:14.5px;color:var(--blue-dark);
    line-height:1.55;margin-bottom:14px;font-style:italic;
  }
  .review-author{display:flex;align-items:center;gap:10px;}
  .review-avatar{
    width:38px;height:38px;border-radius:50%;
    background:var(--orange);color:#fff;
    display:flex;align-items:center;justify-content:center;
    font-weight:800;font-size:15px;
  }
  .review-info strong{display:block;font-size:13px;color:var(--blue-dark);}
  .review-info small{font-size:11.5px;color:var(--gray);}

  .carousel-dots{
    display:flex;justify-content:center;gap:7px;
    margin-top:20px;position:relative;z-index:5;
  }
  .dot-btn{
    width:8px;height:8px;border-radius:50%;
    background:rgba(255,255,255,.3);border:none;cursor:pointer;
    transition:.25s;
  }
  .dot-btn.active{background:var(--orange);transform:scale(1.4);}
  .carousel-arrow{
    position:absolute;top:50%;transform:translateY(-50%);
    width:38px;height:38px;border-radius:50%;
    background:var(--white);color:var(--blue-dark);
    border:none;cursor:pointer;font-size:18px;
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 6px 18px rgba(0,0,0,.2);
    z-index:10;transition:.25s;
  }
  .carousel-arrow:hover{background:var(--orange);color:#fff;transform:translateY(-50%) scale(1.1);}
  .carousel-arrow.left{left:-19px;}
  .carousel-arrow.right{right:-19px;}

  /* ОБРАТНАЯ СВЯЗЬ — КОМПАКТНАЯ */
  .feedback-single{
    background:linear-gradient(135deg, var(--white) 0%, var(--blue-light) 100%);
    border-radius:18px;
    padding:22px 26px;
    box-shadow:var(--shadow);
    border:1px solid #eef3f9;
    display:flex;
    align-items:center;
    gap:20px;
    flex-wrap:wrap;
    transition:.3s;
  }
  .feedback-single:hover{border-color:var(--orange);transform:translateY(-2px);}
  .feedback-single .ico-big{
    font-size:34px;
    flex-shrink:0;
    background:var(--white);
    width:62px;height:62px;
    border-radius:16px;
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 4px 14px rgba(44,62,80,.1);
  }
  .feedback-single .txt{flex:1; min-width:200px;}
  .feedback-single h4{font-size:16px;font-weight:700;margin-bottom:4px;color:var(--blue-dark);}
  .feedback-single p{font-size:13px;color:var(--gray);line-height:1.5;}
  .feedback-single .btn-secondary{flex-shrink:0;font-size:13px;padding:10px 20px;}

  /* FAQ — КОМПАКТНЫЙ */
  .faq-item{
    background:var(--white);
    border-radius:12px;
    margin-bottom:9px;
    box-shadow:var(--shadow);
    border:1px solid #eef3f9;
    overflow:hidden;
    transition:.25s;
  }
  .faq-item:hover{border-color:var(--orange);}
  .faq-q{
    padding:14px 20px;
    font-weight:700;font-size:14px;
    cursor:pointer;
    display:flex;justify-content:space-between;align-items:center;
    color:var(--blue-dark);user-select:none;
  }
  .faq-q::after{
    content:"+";
    font-size:20px;color:var(--orange);
    transition:.3s;font-weight:800;
  }
  .faq-item.open .faq-q::after{transform:rotate(45deg);}
  .faq-a{
    max-height:0;overflow:hidden;
    transition:max-height .35s ease, padding .35s ease;
    padding:0 20px;
    font-size:13px;color:var(--gray);line-height:1.55;
  }
  .faq-item.open .faq-a{max-height:300px;padding:0 20px 15px;}

  /* ЖУРНАЛ */
  .changelog{
    background:var(--white);
    border-radius:18px;padding:6px 0;
    box-shadow:var(--shadow);
    overflow:hidden;
    border:1px solid #eef3f9;
  }
  .log-item{
    display:flex;gap:14px;
    padding:14px 22px;
    border-bottom:1px solid #eef3f9;
    transition:.25s;position:relative;
  }
  .log-item:last-child{border-bottom:none;}
  .log-item:hover{background:var(--blue-light);}
  .log-item.new::before{
    content:"NEW";position:absolute;top:12px;right:18px;
    font-size:9.5px;font-weight:800;letter-spacing:1px;
    background:var(--orange);color:#fff;
    padding:3px 7px;border-radius:5px;
    animation:pulse 1.6s infinite;
  }
  @keyframes pulse{
    0%,100%{box-shadow:0 0 0 0 rgba(255,169,56,.6);}
    50%{box-shadow:0 0 0 6px rgba(255,169,56,0);}
  }
  .log-date{
    flex-shrink:0;width:88px;font-size:12px;
    font-weight:700;color:var(--orange-dark);padding-top:2px;
  }
  .log-body h4{
    font-size:14px;font-weight:700;margin-bottom:3px;
    color:var(--blue-dark);display:flex;align-items:center;flex-wrap:wrap;gap:8px;
  }
  .log-body p{font-size:12.5px;color:var(--gray);}
  .log-ver{
    font-size:10px;font-weight:700;
    color:var(--orange-dark);background:var(--blue-light);
    padding:2px 7px;border-radius:5px;
  }

  /* ТОСТ */
  .toast{
    position:fixed;bottom:20px;right:20px;
    background:var(--blue-dark);color:#fff;
    padding:14px 18px;border-radius:12px;
    box-shadow:0 10px 30px rgba(0,0,0,.3);
    font-size:13px;max-width:300px;
    display:flex;gap:10px;align-items:flex-start;
    transform:translateY(140%);
    transition:transform .45s cubic-bezier(.2,.8,.2,1);
    z-index:100;border-left:4px solid var(--orange);
  }
  .toast.show{transform:translateY(0);}
  .toast-icon{font-size:18px;flex-shrink:0;animation:swing 1.5s ease-in-out infinite;}
  @keyframes swing{
    0%,100%{transform:rotate(0);}
    25%{transform:rotate(14deg);}
    75%{transform:rotate(-14deg);}
  }
  .toast strong{display:block;margin-bottom:2px;color:var(--orange);}
  .toast-close{
    margin-left:auto;background:none;border:none;
    color:#8fa3b8;cursor:pointer;font-size:16px;
    padding:0 3px;transition:.2s;
  }
  .toast-close:hover{color:#fff;transform:rotate(90deg);}

  /* КНОПКА НАВЕРХ */
  .to-top{
    position:fixed;bottom:20px;left:20px;
    width:42px;height:42px;border-radius:50%;
    background:var(--orange);color:#fff;
    border:none;font-size:18px;cursor:pointer;
    box-shadow:0 6px 18px rgba(255,169,56,.5);
    opacity:0;visibility:hidden;transform:translateY(20px);
    transition:.3s;z-index:99;
  }
  .to-top.show{opacity:1;visibility:visible;transform:translateY(0);}
  .to-top:hover{transform:translateY(-3px) scale(1.08);}

  /* ПОДВАЛ */
  footer{
    margin-top:44px;
    background:var(--blue-dark);color:#a9b8c9;
    padding:28px 20px 22px;text-align:center;
    font-size:13px;position:relative;overflow:hidden;
  }
  footer::before{
    content:"";position:absolute;top:0;left:0;right:0;height:3px;
    background:linear-gradient(90deg, var(--orange), var(--orange-light), var(--orange));
    background-size:200% 100%;animation:slide 3s linear infinite;
  }
  @keyframes slide{to{background-position:-200% 0;}}
  footer .foot-logo{
    display:inline-flex;align-items:center;gap:9px;
    font-size:17px;font-weight:800;color:#fff;margin-bottom:10px;
  }
