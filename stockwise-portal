  e.preventDefault();
  e.stopPropagation();
  const tip = btn.nextElementSibling;
  const isOpen = tip.classList.contains('show');
  document.querySelectorAll('.tooltip').forEach(t=>t.classList.remove('show'));
  if(!isOpen) tip.classList.add('show');
}
document.addEventListener('click', ()=>{
  document.querySelectorAll('.tooltip').forEach(t=>t.classList.remove('show'));
});
document.querySelectorAll('.tooltip').forEach(t=>{
  t.addEventListener('click', e=>e.stopPropagation());
});

/* ТОСТ */
const LAST_VERSION = 'v1.0';
const toast = document.getElementById('toast');
const toastText = document.getElementById('toast-text');
const firstLog = document.querySelector('.log-item .log-body h4');
if(firstLog) toastText.textContent = firstLog.textContent.replace('NEW','').trim();

const seen = localStorage.getItem('stockwise_seen_version');
if(seen !== LAST_VERSION){
  setTimeout(()=>toast.classList.add('show'), 1200);
}
function closeToast(){
  toast.classList.remove('show');
  localStorage.setItem('stockwise_seen_version', LAST_VERSION);
}

/* СЧЁТЧИКИ */
const counters = document.querySelectorAll('.stat .num');
const statObserver = new IntersectionObserver((entries)=>{
  entries.forEach(entry=>{
    if(entry.isIntersecting){
      const el = entry.target;
      const target = +el.dataset.count;
      const suffix = el.dataset.suffix || '';
      let current = 0;
      const step = Math.max(1, Math.ceil(target/40));
      const timer = setInterval(()=>{
        current += step;
        if(current >= target){ current = target; clearInterval(timer); }
        el.textContent = current + suffix;
      }, 30);
      statObserver.unobserve(el);
    }
  });
}, {threshold:.5});
counters.forEach(c=>statObserver.observe(c));

/* ПРОГРЕСС И КНОПКА НАВЕРХ */
const progressBar = document.getElementById('readProgress');
const toTop = document.getElementById('toTop');
window.addEventListener('scroll', ()=>{
  const h = document.documentElement;
  const scrolled = (h.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
  progressBar.style.width = scrolled + '%';
  if(window.scrollY > 400) toTop.classList.add('show');
  else toTop.classList.remove('show');
});

/* КАРУСЕЛЬ */
let currentReview = 0;
const reviews = document.querySelectorAll('.review');
const dotsContainer = document.getElementById('carouselDots');
let autoTimer;

reviews.forEach((_, i)=>{
  const d = document.createElement('button');
  d.className = 'dot-btn' + (i===0 ? ' active' : '');
  d.onclick = ()=>goToReview(i);
  dotsContainer.appendChild(d);
});
const dots = document.querySelectorAll('.dot-btn');

function updateCarousel(){
  const total = reviews.length;
  reviews.forEach((r, i)=>{
    r.classList.remove('active','prev','next');
    if(i === currentReview) r.classList.add('active');
    else if(i === (currentReview - 1 + total) % total) r.classList.add('prev');
    else if(i === (currentReview + 1) % total) r.classList.add('next');
  });
  dots.forEach((d,i)=>d.classList.toggle('active', i===currentReview));
}
function moveReview(dir){
  currentReview = (currentReview + dir + reviews.length) % reviews.length;
  updateCarousel();
  restartAuto();
}
function goToReview(i){
  currentReview = i;
  updateCarousel();
  restartAuto();
}
function restartAuto(){
  clearInterval(autoTimer);
  autoTimer = setInterval(()=>moveReview(1), 6000);
}
updateCarousel();
restartAuto();

/* FAQ */
function toggleFaq(el){
  const item = el.parentElement;
  const wasOpen = item.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(i=>i.classList.remove('open'));
  if(!wasOpen) item.classList.add('open');
}

/* КЛИК ПО КАРТОЧКАМ */
document.querySelectorAll('.card').forEach(card=>{
  card.addEventListener('click', function(e){
    if(e.target.classList.contains('info-btn')) return;
    this.style.transition = 'transform .1s';
    this.style.transform = 'translateY(-1px) scale(.99)';
    setTimeout(()=>{ this.style.transform=''; this.style.transition=''; }, 150);
  });
});
</script>

